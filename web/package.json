{
  "name": "web",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "generate:api": "orval --config orval.config.ts",
    "snapshot:api": "curl -fsS ${API_URL:-http://localhost:1080}/openapi.json | node scripts/format-openapi.mjs > openapi.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/schibsted-grotesk": "^5.2.0",
    "@mdi/font": "^7.4.47",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vuetify": "^4.3.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^31.0.1",
    "orval": "^8.48.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
